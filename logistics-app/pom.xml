<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.siose.ff</groupId>
        <artifactId>ff-base-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <!--
        FF Logistic as one process: every business area from shared's domain cores, wired together
        in-process. Spring Modulith checks the boundaries between them (ModularityTest).
    -->
    <groupId>com.siose.ff</groupId>
    <artifactId>logistics-app</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>FF Logistic - Modulith - logistics-app</name>
    <description>FF Logistic as one Spring Modulith application.</description>

    <properties>
        <ff-domain.version>0.1.0-SNAPSHOT</ff-domain.version>
    </properties>

    <dependencies>
        <!-- The business: all four areas -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-domain-standards</artifactId>
            <version>${ff-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-domain-warehousing</artifactId>
            <version>${ff-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-domain-transportation</artifactId>
            <version>${ff-domain.version}</version>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-domain-routing</artifactId>
            <version>${ff-domain.version}</version>
        </dependency>

        <!-- The chassis, the same on both sides -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-base-app</artifactId>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-base-web</artifactId>
        </dependency>
        <!-- Documents (S05-05): the S3 client, so ff-base-storage wires its S3 adapter (RustFS in the cluster) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-base-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-base-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- @Valid on the areas' request bodies: without a validator, they would not be checked -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-registry-otlp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!--
            The flows between areas are events (flow 2). The registry stores each one with the
            change that caused it, in this process's outbox (ff-base-events: schema "modulith"),
            and delivers it again if a listener fails.
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-base-events</artifactId>
        </dependency>
        <!--
            The events marked @Externalized also go to Kafka, from this process's outbox (S6): the
            same topics and the same JSON as the services, so a reader cannot tell which side sent
            them. Between the areas, the events still stay in this JVM.
        -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A Kafka broker inside the test JVM: what leaves this process is read back for real -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The event contracts (ff-contracts): what this process sends is checked against them -->
        <dependency>
            <groupId>com.siose.ff</groupId>
            <artifactId>ff-contracts</artifactId>
            <version>${ff-domain.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar name the Dockerfile copies, without the version -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
